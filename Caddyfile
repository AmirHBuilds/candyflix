# One public address for everything. Caddy gets and renews the HTTPS certificate by itself.
# {$DOMAIN} comes from .env.prod (e.g. candyflix.example.com).
{$DOMAIN} {
	encode zstd gzip

	# The API and the files the backend serves (profile pictures, subtitles) go to the backend...
	@backend path /api/* /avatars/* /subtitle-cache/* /mock-videos/*
	handle @backend {
		# flush_interval -1: send video / live responses straight through instead of buffering them.
		reverse_proxy backend:8000 {
			flush_interval -1
			transport http {
				response_header_timeout 5m
			}
		}
	}

	# ...everything else is the website.
	handle {
		reverse_proxy frontend:3000
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
