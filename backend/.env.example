# Copy this file to .env for local development.
# In docker-compose, these are provided via the compose file / a root .env instead.

APP_NAME=CandyFlix
ENVIRONMENT=development
DEBUG=true

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://candyflix:candyflix@localhost:5432/candyflix

# Redis
REDIS_URL=redis://localhost:6379/0

# TMDB — get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3

# OMDb (Phase 12 — IMDb / Rotten Tomatoes / Metacritic scores on detail pages)
# Free key (1,000 requests a day, results are cached): https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# OpenSubtitles (Phase 5b — online subtitle discovery)
# Free API key: https://www.opensubtitles.com/en/consumers
# The username/password ARE technically optional (the API key alone is
# enough to authenticate requests), but OpenSubtitles has a history of
# aggressively throttling/rejecting key-only, non-logged-in requests
# (see their 2020 "API requests must be authenticated" policy change) —
# so in practice, set these too, using the same account you registered
# the API key with, or search/download may fail with 401/403/429.
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USER_AGENT=CandyFlix v1.0
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# Session secret (used starting Phase 2) — generate a real random value before Phase 2
SESSION_SECRET=change-me-in-env

# CORS
FRONTEND_ORIGIN=http://localhost:3000

# --- Phase 14: Ask AI (Google Gemini) ---
# Free key: https://aistudio.google.com/apikey  (free tier: Google may use what is sent to improve
# its products; CandyFlix sends only the request plus titles/years, never names.)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# AI searches per person per day (admins: unlimited; changeable per person in Admin -> Users)
# AI_DEFAULT_DAILY_LIMIT=5

# --- Phase 17: Telegram reports (all optional; leave empty to turn off) ---
# 1. Talk to @BotFather -> /newbot -> copy the token.
# 2. Make a group, turn on Topics (Group settings -> Topics), add the bot and make it an admin.
# 3. Chat id: add @RawDataBot (or @getidsbot) to the group once and read "chat id" (starts with -100), then remove it.
# 4. Topic ids: create a topic per report, then open it in Telegram Web / "Copy link" -> the link is
#    https://t.me/c/<chat>/<TOPIC_ID>/... . Use that middle number. (The General topic has none: leave it empty.)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_SIGN_INS=
TELEGRAM_TOPIC_ACCOUNTS=
TELEGRAM_TOPIC_ADMIN=
TELEGRAM_TOPIC_AI=
TELEGRAM_TOPIC_SECURITY=
TELEGRAM_TOPIC_ERRORS=
TELEGRAM_TOPIC_SYSTEM=
