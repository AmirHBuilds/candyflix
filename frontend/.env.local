# Copy this file to .env.local for local development (plain `npm run dev`,
# no Docker). Not used by docker-compose, which sets its own values —
# see docker-compose.yml for API_URL_INTERNAL, needed there because
# server-side (SSR) code inside the frontend container can't reach the
# backend container via "localhost".

NEXT_PUBLIC_API_URL=http://localhost:8000/api
